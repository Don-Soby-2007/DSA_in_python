    "def mergeSort(arr, low, high):\n",
    "\n",
    "    if low < high:\n",
    "        mid = low + (high - low)//2\n",
    "\n",
    "        mergeSort(arr, low, mid)\n",
    "        mergeSort(arr, mid + 1, high)\n",
    "        merge(arr, low, mid, high)"
   ]
